{
  "name": "barka",
  "version": "0.1.0",
  "private": true,
  "description": "BARKA SARL — plateforme immobilière et foncière, fondations de la phase 1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "format": "prettier --write .",
    "setup:local": "node scripts/setup-local.mjs",
    "lint": "eslint .",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:auth": "playwright test --config=playwright.auth.config.ts",
    "test:db": "tsx scripts/verify-demo-seed.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:demo-password": "tsx scripts/set-demo-password.ts",
    "media:cleanup": "node --conditions=react-server --import tsx scripts/process-media-jobs.ts",
    "demo:immersive": "node scripts/generate-tour-demo.mjs",
    "build:vercel": "node scripts/vercel-build.mjs",
    "deploy:check": "tsx scripts/check-deployment.ts",
    "db:bootstrap": "tsx scripts/bootstrap-production.ts",
    "db:status": "prisma migrate status",
    "db:inspect": "tsx scripts/inspect-database.ts",
    "test:bootstrap": "node --conditions=react-server --import tsx scripts/verify-production-bootstrap.ts",
    "test:hosted-media": "node --conditions=react-server --import tsx scripts/verify-hosted-media.ts",
    "db:retire-demo": "tsx scripts/retire-demo-accounts.ts",
    "storage:check": "node --conditions=react-server --import tsx scripts/check-storage.ts"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1164.0",
    "@hookform/resolvers": "6.0.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-slot": "^1.5.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.9",
    "iron-session": "9.0.1",
    "leaflet": "1.9.4",
    "lucide-react": "^1.64.0",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "7.91.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.0",
    "three": "0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
