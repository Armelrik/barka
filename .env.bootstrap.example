BOOTSTRAP_COMPANY_NAME=BARKA SARL
BOOTSTRAP_ADMIN_FIRST_NAME=
BOOTSTRAP_ADMIN_LAST_NAME=
BOOTSTRAP_ADMIN_PHONE=
