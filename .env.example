DATABASE_URL=postgresql://barka:barka_local_only@localhost:5432/barka?schema=public
DIRECT_URL=
DATABASE_POOL_MAX=5
# Required only when explicitly running demo seeds. Never reuse in production.
DEMO_PASSWORD=
AUTH_SECRET=
AUTH_URL=http://localhost:3000
BARKA_COMPANY_CODE=BARKA-DEMO
# Required to open registration in production, after replacing/validating legal documents.
REGISTRATION_ENABLED=false
LEGAL_DOCUMENTS_APPROVED=false
# Enable only behind an ingress that overwrites spoofable forwarding headers.
AUTH_TRUST_PROXY_HEADERS=false
# Neon Object Storage: use the Storage endpoint and credential values, not the PostgreSQL password.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
PAYMENT_PROVIDER=mock

# demo keeps the fictional catalogue available without PostgreSQL.
CATALOG_MODE=demo
# Use s3 in production. Local media are private files outside public/.
MEDIA_DRIVER=local
MEDIA_LOCAL_DIR=.barka-media
# Local, loopback-only production preview and isolated tests; never enable on hosting.
MEDIA_LOCAL_PREVIEW=false

# Optional public tile provider; attribution must remain compatible with its terms.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Set to 4 for Vercel relay uploads; leave empty on an unrestricted Node host.
NEXT_PUBLIC_MEDIA_MAX_MB=
