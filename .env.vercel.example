# Add privately to the matching Vercel environment. Never commit filled values.
# Neon runtime: pooled (-pooler host); migration: same branch/database, direct host.
DATABASE_URL=
DIRECT_URL=
DATABASE_POOL_MAX=2
AUTH_SECRET=
# Production: exact canonical origin. Preview: unset to use the trusted VERCEL_URL.
AUTH_URL=
BARKA_COMPANY_CODE=BARKA
CATALOG_MODE=database
REGISTRATION_ENABLED=false
LEGAL_DOCUMENTS_APPROVED=false
AUTH_TRUST_PROXY_HEADERS=false
MEDIA_DRIVER=s3
# Neon Object Storage: use the Storage endpoint and credential values, not the PostgreSQL password.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_LOCAL_PREVIEW=false
NEXT_PUBLIC_MEDIA_MAX_MB=4
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Explicitly opt in to migrate deploy at Production build time, after database review.
RUN_DATABASE_MIGRATIONS=false
